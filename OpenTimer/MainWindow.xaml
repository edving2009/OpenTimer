<Window x:Class="OpenTimer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="OpenTimer"
        Width="650"
        Height="400"
        MinWidth="500"
        MinHeight="400"
        Background="#F7F7F5"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#202124"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#777777"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E2E2DF"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#202124"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="Margin" Value="5,0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#343434"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#111111"/>
                </Trigger>

                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E8E8E6"/>
                    <Setter Property="Foreground" Value="#AAAAAA"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#E8E8E6"/>
            <Setter Property="Foreground" Value="#777777"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DDDDDB"/>
                    <Setter Property="Foreground" Value="#555555"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#D2D2D0"/>
                </Trigger>

                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E8E8E6"/>
                    <Setter Property="Foreground" Value="#AAAAAA"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="OpenTimer" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="TASK" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Margin="2,0,0,6"/>

            <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Height="44">
                <TextBox x:Name="TaskName" FontSize="16" Foreground="{StaticResource TextBrush}" Background="Transparent" BorderThickness="0" Padding="12,8" VerticalContentAlignment="Center"/>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="TimeText" Text="90:00" FontSize="64" FontWeight="Light" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                <TextBlock Text="Duration" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>

                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                    <TextBox x:Name="TimerInputBox" Width="50" Height="28" Text="90" FontSize="13" TextAlignment="Center" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent"/>
                </Border>

                <TextBlock Text="min" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="7,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="StartButton" Content="Start" Width="100" Height="42" Style="{StaticResource ActionButton}" Click="Start_Button_Click"/>
            <Button x:Name="PauseButton" Content="Pause" Width="100" Height="42" Style="{StaticResource SecondaryButton}" Click="Pause_Button_Click"/>
            <Button x:Name="ResumeButton" Content="Resume" Width="100" Height="42" Style="{StaticResource SecondaryButton}" Click="Resume_Button_Click"/>
            <Button x:Name="StopButton" Content="Stop" Width="100" Height="42" Style="{StaticResource SecondaryButton}" Click="Stop_Button_Click"/>
        </StackPanel>
    </Grid>
</Window>